<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================ -->
    <!-- bitdreamit-astm v3.0.3 — Parent POM                          -->
    <!-- Multi-module Maven project (matches the pattern used in      -->
    <!-- bitdreamit-astm-e1381-transmission)                          -->
    <!-- ============================================================ -->

    <groupId>com.bitdreamit.connect.plugins.astm</groupId>
    <artifactId>bitdreamit-astm</artifactId>
    <version>3.0.3</version>
    <packaging>pom</packaging>

    <name>bitdreamit-astm</name>
    <description>ASTM E1381/E1394 plugin for Mirth Connect (TCP + Serial)</description>
    <url>https://bitdreamit.com</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- ============================================================ -->
    <!-- Properties                                                    -->
    <!--                                                              -->
    <!-- mirth.libs.path: location of your Mirth Connect JARs         -->
    <!--   - Default: ${user.home}/mirth-libs (Linux/Mac)             -->
    <!--     = /home/user/mirth-libs OR /Users/user/mirth-libs        -->
    <!--   - On Windows: edit pom.xml or use                          -->
    <!--       mvn -Dmirth.libs.path=D:/Java/mirth-libs install       -->
    <!--                                                              -->
    <!--   The mirth-libs folder must have subfolders:                -->
    <!--     mirth-libs/                                              -->
    <!--     ├── client/                                              -->
    <!--     │   ├── mirth-client-core.jar                            -->
    <!--     │   ├── mirth-client.jar                                 -->
    <!--     │   ├── miglayout-core-4.2.jar                           -->
    <!--     │   └── miglayout-swing-4.2.jar                          -->
    <!--     └── server/                                              -->
    <!--         ├── mirth-server.jar                                 -->
    <!--         ├── donkey-server.jar                                -->
    <!--         ├── donkey-model.jar                                 -->
    <!--         └── log4j-1.2-api-2.17.2.jar                         -->
    <!-- ============================================================ -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Path to Mirth Connect JARs. Override with -Dmirth.libs.path=... -->
        <mirth.libs.path>${user.home}/mirth-libs</mirth.libs.path>

        <!-- Mirth Connect version (4.5.2 by default — adjust for your version) -->
        <mirth.version>4.5.2</mirth.version>

        <!-- Library versions -->
        <log4j.version>2.17.2</log4j.version>
        <junit.version>4.13.2</junit.version>
        <hamcrest.version>1.3</hamcrest.version>
        <miglayout.version>4.2</miglayout.version>
        <jserialcomm.version>2.10.4</jserialcomm.version>
        <commons-lang3.version>3.13.0</commons-lang3.version>
        <xstream.version>1.4.20</xstream.version>

        <!-- Java version -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <!-- ============================================================ -->
    <!-- Modules                                                       -->
    <!-- ============================================================ -->
    <modules>
        <module>astm-async</module>
        <module>astm-shared</module>
        <module>astm-server</module>
        <module>astm-client</module>
    </modules>

    <!-- ============================================================ -->
    <!-- Dependency Management — system-scope JARs from mirth-libs    -->
    <!--                                                              -->
    <!-- systemPath uses ${mirth.libs.path}/client/... or /server/... -->
    <!-- ============================================================ -->
    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.bitdreamit.connect.plugins.astm</groupId>
                <artifactId>astm-async</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bitdreamit.connect.plugins.astm</groupId>
                <artifactId>astm-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Mirth Connect — client-side JARs -->
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client-core</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/client/mirth-client-core.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/client/mirth-client.jar</systemPath>
            </dependency>

            <!-- Mirth Connect — server-side JARs -->
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/server/mirth-server.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>donkey-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/server/donkey-server.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>donkey-model</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/server/donkey-model.jar</systemPath>
            </dependency>

            <!-- Log4j 1.2 API bridge (Mirth uses this for org.apache.log4j.Logger) -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-1.2-api</artifactId>
                <version>${log4j.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/server/log4j-1.2-api-${log4j.version}.jar</systemPath>
            </dependency>

            <!-- MigLayout (UI layout for client module) -->
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-core</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/client/miglayout-core-${miglayout.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-swing</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs.path}/client/miglayout-swing-${miglayout.version}.jar</systemPath>
            </dependency>

            <!-- jSerialComm (bundled — already in sign/bitdreamit-astm/lib/) -->
            <dependency>
                <groupId>com.fazecast</groupId>
                <artifactId>jSerialComm</artifactId>
                <version>${jserialcomm.version}</version>
                <scope>system</scope>
                <systemPath>${project.basedir}/sign/bitdreamit-astm/lib/jSerialComm-${jserialcomm.version}.jar</systemPath>
            </dependency>

            <!-- Test dependencies -->
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest-core</artifactId>
                <version>${hamcrest.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================ -->
    <!-- Build configuration                                           -->
    <!-- ============================================================ -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
